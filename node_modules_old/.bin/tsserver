#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/efs/sessions/ce3846f9-c58d-4cfd-b8b0-6ba8be0815bc/agent_2/node_modules/.pnpm/typescript@5.9.3/node_modules/typescript/node_modules:/mnt/efs/sessions/ce3846f9-c58d-4cfd-b8b0-6ba8be0815bc/agent_2/node_modules/.pnpm/typescript@5.9.3/node_modules:/mnt/efs/sessions/ce3846f9-c58d-4cfd-b8b0-6ba8be0815bc/agent_2/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/efs/sessions/ce3846f9-c58d-4cfd-b8b0-6ba8be0815bc/agent_2/node_modules/.pnpm/typescript@5.9.3/node_modules/typescript/node_modules:/mnt/efs/sessions/ce3846f9-c58d-4cfd-b8b0-6ba8be0815bc/agent_2/node_modules/.pnpm/typescript@5.9.3/node_modules:/mnt/efs/sessions/ce3846f9-c58d-4cfd-b8b0-6ba8be0815bc/agent_2/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../typescript/bin/tsserver" "$@"
else
  exec node  "$basedir/../typescript/bin/tsserver" "$@"
fi
